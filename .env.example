# Environment Variables
# Copy this file to .env and update with your actual values

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=myteacher

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET=your-access-token-secret
JWT_REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_COOKIE_NAME=your-cookie-name

# Flutterwave Payment Gateway
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=

# Frontend URL (for payment redirects and CORS)
FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:4000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/google/callback

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_EMAIL_SENDER=onboarding@resend.dev

# IP Location Service
IPLOCATE_API_KEY=your-iplocate-api-key

# Socket.io Configuration
SOCKET_PORT=4000
SOCKET_PATH=/socket.io

# Web Push Notifications (VAPID Keys)
# Generate these using: npx web-push generate-vapid-keys
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
